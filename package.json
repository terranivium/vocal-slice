{
  "name": "vocal-slice",
  "version": "2.0.0",
  "description": "AI-powered audio transcription and voice line extraction",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "fix-electron": "node node_modules/electron/install.js",
    "vendor": "node build-scripts/vendor.js",
    "models:mirror": "node build-scripts/mirror-models.js",
    "models:publish": "node build-scripts/publish-models.js",
    "notices": "node build-scripts/notices.js",
    "checksums": "node build-scripts/checksums.js",
    "release-notes": "node build-scripts/release-notes.js",
    "changelog:promote": "node build-scripts/release-notes.js --promote",
    "changelog:site": "node build-scripts/changelog-site.js",
    "release:check": "node build-scripts/release-check.js",
    "downloads": "node build-scripts/downloads.js",
    "prebuild": "node build-scripts/minify.js",
    "build": "node build-scripts/pack.js",
    "build:win": "npm run prebuild && node build-scripts/pack.js --win",
    "build:portable": "npm run prebuild && node build-scripts/pack.js --win portable",
    "build:mac": "npm run prebuild && node build-scripts/pack.js --mac",
    "build:linux": "npm run prebuild && node build-scripts/pack.js --linux",
    "release:win": "npm run prebuild && node build-scripts/pack.js --win nsis --publish always && node build-scripts/release-notes.js",
    "release:mac": "npm run prebuild && node build-scripts/pack.js --mac --publish always && node build-scripts/release-notes.js",
    "postinstall": "electron-builder install-app-deps && node build-scripts/vendor.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "audio",
    "transcription",
    "whisper",
    "webgpu",
    "ai"
  ],
  "author": "Wesley Scott",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/terranivium/vocal-slice.git"
  },
  "homepage": "https://vocalslice.com",
  "private": true,
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@huggingface/transformers": "^4.2.0",
    "@phosphor-icons/web": "^2.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^25.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.28.1",
    "html-minifier-terser": "^7.2.0"
  },
  "build": {
    "appId": "com.vocalslice.app",
    "productName": "Vocal Slice",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./build-scripts/fuses.js",
    "artifactBuildCompleted": "./build-scripts/notarize-dmg.js",
    "publish": [
      {
        "provider": "github",
        "owner": "terranivium",
        "repo": "vocal-slice"
      }
    ],
    "files": [
      "electron/**/*",
      "static/**/*",
      "!static/index.html",
      "!static/styles.css",
      "!static/js/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "static/AppIcon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "static/AppIcon.icns",
      "artifactName": "VocalSlice-macOS-update.${ext}",
      "identity": "Wesley Scott (4T5WM695NP)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "artifactName": "VocalSlice.${ext}",
      "sign": true,
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "VocalSlice-Setup.${ext}"
    },
    "portable": {
      "artifactName": "VocalSlice-Portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
